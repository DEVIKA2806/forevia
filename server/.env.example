# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string used by the running app (Express + the
# Prisma driver adapter). For Neon, this is the POOLED connection string
# — its hostname contains "-pooler" (e.g. ep-xxxx-pooler.<region>.aws.neon.tech).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://forevia_user:forevia_password@localhost:5432/forevia_db"

# PostgreSQL connection string used by the Prisma CLI (migrate, studio).
# For Neon, this is the DIRECT (non-pooled) connection string — same
# credentials/database as above, but WITHOUT "-pooler" in the hostname.
# Migrate needs this because pooled/PgBouncer connections don't support
# the session-level features (advisory locks, prepared statements) that
# schema migrations rely on.
DIRECT_URL="postgresql://forevia_user:forevia_password@localhost:5432/forevia_db"

# Port the Express server listens on
PORT=5000

# Secret used to sign JWTs — use a long random string in real environments
JWT_SECRET="replace-this-with-a-long-random-string"

# How long a login session stays valid
JWT_EXPIRES_IN="7d"

# The URL of the React dev server, used to configure CORS
CLIENT_URL="http://localhost:5173"

# "development" or "production" — affects cookie security flags
NODE_ENV=development

# ---------------------------------------------------------------------------
# AI Insights (Phase 10) — Google Gemini
# The key lives ONLY here on the server. Never put it in client/.env or in
# any VITE_ variable: everything VITE_ is shipped to the browser.
# ---------------------------------------------------------------------------

# Which provider adapter to use: "gemini" (default) or "anthropic"
AI_PROVIDER=gemini

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# Leave empty and AI Insights simply reports "not set up".
AI_API_KEY=""

# Model to call. gemini-3.8-flash is free-tier eligible. If you hit the free
# quota often, gemini-3.5-flash-lite is a lighter free-tier alternative.
AI_MODEL=gemini-3.8-flash

# Optional. Gemini thinking effort: minimal | low | medium | high (default low)
# AI_THINKING_LEVEL=low

# Optional. Give up on a slow AI response after this many milliseconds (default 30000)
# AI_TIMEOUT_MS=30000

# Optional. Override the provider endpoint (leave unset for Google's default).
# AI_BASE_URL=